cat > .gitignore << 'EOF'
# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin
.kotlin/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/

# JDK for cross-compilation (downloaded locally, NOT committed)
/java/

# Native build artifacts
src/main/cpp/build/
src/main/cpp/build-win/
build-native-output/
native-cross-output/

# OS
.DS_Store
Thumbs.db
EOF